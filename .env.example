# Mot de passe pour /admin (obligatoire)
ADMIN_PASSWORD=change-moi

# URL publique encodée dans le QR code (ton domaine en HTTPS).
# Si vide, on prend l'adresse avec laquelle tu ouvres /admin.
PUBLIC_URL=https://wannadate.exemple.com

# Port exposé sur la machine hôte
HOST_PORT=3003

# Fuseau horaire pour les dates affichées
TZ=America/Toronto
